# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- RAG API ---
# clients send it as X-API-Key
RAG_API_KEY=change-me
RAG_PORT=8080

# --- Chat model (any OpenAI-compatible endpoint: OpenAI, SGLang, vLLM, ...) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Embeddings for the regulation index (any OpenAI-compatible /v1/embeddings) ---
# Default: bge-m3 natively via Ollama on the host (Metal GPU on a Mac):
#   brew install ollama && brew services start ollama && ollama pull bge-m3
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
# Changing the embedding model: rerun `python -m regs build` and `train-ltr` (see docker-compose.yml).

# --- Local models (commented-out `llm` + `embed` services in docker-compose.yml) ---
# LLM_BASE_URL=http://llm:30000/v1
# LLM_API_KEY=local
# LLM_MODEL=Qwen/Qwen3.5-9B
# EMBED_BASE_URL=http://embed:80/v1
# EMBED_API_KEY=local
# EMBED_MODEL=BAAI/bge-m3
# HF_TOKEN=
# Switching embedding model: rebuild the index (python -m regs build + train-ltr).

# Optional
# REGS_* settings: see rag/regs/config.py
